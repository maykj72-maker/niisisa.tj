{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start certificate registry API",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"backend.app:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"options": {
				"cwd": "${workspaceFolder}\\reestr_saytovkvd",
				"shell": {
					"executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
					"args": ["-NoProfile", "-Command"]
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start certificate registry website",
			"type": "shell",
			"command": "npm.cmd",
			"args": ["run", "dev"],
			"options": {
				"cwd": "${workspaceFolder}\\reestr_saytovkvd\\frontend",
				"shell": {
					"executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
					"args": ["-NoProfile", "-Command"]
				}
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}